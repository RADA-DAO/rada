{
  "compilerOptions": {
    "allowJs": true,
    "types": ["node", "vite/client"],
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "tools/**/*.mjs",
    "packages/**/*.ts",
    "packages/**/*.mjs",
    "apps/miniapp/**/*.ts",
    "modules/**/*.ts"
  ],
  "exclude": ["modules/*/api/**", "modules/*/index.ts"]
}
