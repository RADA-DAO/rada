{
  "compilerOptions": {
    "allowJs": true,
    "types": ["node", "vite/client"],
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "tools/**/*.mjs",
    "packages/**/*.ts",
    "apps/miniapp/**/*.ts",
    "modules/jpegpe/**/*.ts"
  ]
}
