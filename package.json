{
  "name": "rada",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && node --check tools/check.mjs && node tools/check.mjs",
    "typecheck": "tsc",
    "test:unit": "node --test tools/check.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "commits": "node tools/commits.mjs",
    "e2e": "node tools/e2e.mjs",
    "db:config": "docker compose --env-file .env -f infra/compose/local.yaml config --quiet",
    "db:up": "docker compose --env-file .env -f infra/compose/local.yaml up -d postgres",
    "db:down": "docker compose --env-file .env -f infra/compose/local.yaml down"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "markdownlint": "0.42.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
