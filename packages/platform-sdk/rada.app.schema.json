{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rada.app.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "author",
    "trustLevel",
    "designRoute",
    "permissions",
    "minPlatformVersion"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "author": { "type": "string", "minLength": 1, "maxLength": 64 },
    "trustLevel": { "enum": ["community", "official"] },
    "designRoute": { "enum": ["standard", "free-style"] },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 18,
      "items": {
        "enum": [
          "identity.self.read",
          "theme.read",
          "navigation",
          "storage.self",
          "dao.public.read",
          "telegram.username.read",
          "wallet.address.read",
          "wallet.balances.read",
          "jpegpe.collection.read",
          "notifications.send",
          "money.exchange",
          "money.transfer",
          "frog.transfer",
          "wallet.sign",
          "governance.vote",
          "treasury.request",
          "frog.issue",
          "rewards.grant"
        ]
      }
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(/[a-z0-9][a-z0-9._-]{0,63}){0,2}\\.(png|webp|svg)$",
      "description": "Relative path inside the artifact's own folder to a square PNG, WebP or SVG of at most 64 KB."
    },
    "minPlatformVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
