{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rada.app.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "author",
    "designRoute",
    "permissions",
    "minPlatformVersion"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "trustLevel": {
      "const": "community",
      "description": "Retired. Official status is a registry decision and cannot be declared."
    },
    "designRoute": {
      "enum": ["standard", "free-style"]
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 19,
      "items": {
        "enum": [
          "identity.self.read",
          "theme.read",
          "navigation",
          "storage.self",
          "dao.public.read",
          "telegram.username.read",
          "wallet.address.read",
          "wallet.balances.read",
          "jpegpe.collection.read",
          "notifications.send",
          "money.exchange",
          "money.transfer",
          "frog.transfer",
          "wallet.sign",
          "governance.vote",
          "treasury.request",
          "frog.issue",
          "rewards.grant",
          "scores"
        ]
      }
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(/[a-z0-9][a-z0-9._-]{0,63}){0,2}\\.(png|webp|svg)$",
      "description": "Relative path inside the artifact's own folder to a square PNG, WebP or SVG of at most 64 KB."
    },
    "minPlatformVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "boards": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "max"],
        "properties": {
          "min": {
            "type": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          },
          "max": {
            "type": "integer",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "scores"
            }
          }
        }
      },
      "then": {
        "required": ["boards"]
      },
      "else": {
        "not": {
          "required": ["boards"]
        }
      }
    }
  ]
}
