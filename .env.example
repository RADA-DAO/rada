# Disposable local database placeholders only. Never reuse production credentials.
POSTGRES_DB=rada_local
POSTGRES_USER=rada_local
POSTGRES_PASSWORD=replace-with-disposable-local-value

# Optional bearer token for GET /health/errors (failure counters). Unset disables the route.
API_OPS_TOKEN=

# Staging only: password for the staging_ops login (client error reports). No value committed.
OPS_PASSWORD=

# Staging only: password for the staging_splash login (SPLASH submissions, rounds, bids). No value committed.
SPLASH_PASSWORD=

# Optional hourly failure digest to the operator via the existing bot. Off unless ALERTS_ENABLED=true.
ALERTS_ENABLED=
ALERT_TELEGRAM_CHAT_ID=
