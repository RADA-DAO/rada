# Disposable local database placeholders only. Never reuse production credentials.
POSTGRES_DB=rada_local
POSTGRES_USER=rada_local
POSTGRES_PASSWORD=replace-with-disposable-local-value
# Optional bearer token for GET /health/errors (failure counters). Unset disables the route.
API_OPS_TOKEN=
# Staging only: password for the staging_ops login (client error reports). No value committed.
OPS_PASSWORD=
# Staging only: password for the staging_splash login (SPLASH submissions, rounds, bids). No value committed.
SPLASH_PASSWORD=
# Optional hourly failure digest to the operator via the existing bot. Off unless ALERTS_ENABLED=true.
ALERTS_ENABLED=
ALERT_TELEGRAM_CHAT_ID=
# Staging only: distinct password for the governance service login.
GOVERNANCE_PASSWORD=
# Rankings: separate restricted API and projection worker connections. No values committed.
RANKINGS_SERVICE_DATABASE_URL=
RANKINGS_WORKER_DATABASE_URL=
# Staging login passwords and explicit background chain-read opt-in (default off).
RANKINGS_PASSWORD=
RANKINGS_WORKER_PASSWORD=
RANKINGS_WORKER_ENABLED=

# Platform Telegram notifications: disabled until explicitly enabled.
NOTIFICATIONS_PASSWORD=
NOTIFICATIONS_SERVICE_DATABASE_URL=
NOTIFICATIONS_ENABLED=false

# Read-only treasury projection; separate staging login, worker defaults off.
TREASURY_PASSWORD=
TREASURY_WORKER_ENABLED=false

# Public HTTPS t.me bot or Mini App link used by the browser entry screen.
VITE_TELEGRAM_APP_LINK=
